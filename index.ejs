<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Amazon Alpha - Shop</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #eaeded; padding-bottom: 90px; }
        .amazon-nav { background-color: #131921; }
        .card { border: none; border-radius: 8px; background: #fff; transition: all 0.2s ease; }
        .card:hover { transform: translateY(-3px); box-shadow: 0 8px 16px rgba(0,0,0,0.1) !important; }
        .card-img-top { border-radius: 8px 8px 0 0; height: 200px; object-fit: cover; background-color: #f8f9fa; }
        .btn-amazon { background: #ffd814; border: none; color: #0f1111; border-radius: 20px; font-weight: 500; font-size: 14px; }
        .btn-amazon:hover { background: #f7ca00; }
        .bottom-nav { background: #ffffff; border-top: 1px solid #ddd; z-index: 1030; }
        .nav-link-custom { text-decoration: none; color: #565959; font-size: 12px; font-weight: 500; }
        .nav-link-custom.active, .nav-link-custom:hover { color: #e77600; }
        .nav-icon { font-size: 20px; display: block; margin-bottom: 2px; }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark amazon-nav px-3 py-2 sticky-top shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand fw-bold fs-4 m-0 text-white" href="/">
                amazon<span class="text-warning fs-5">.alpha</span>
            </a>
            <div class="text-white-50 small d-none d-sm-block">📍 Deliver to Hanamkonda</div>
            <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/logout">Sign Out</a>
        </div>
    </nav>

    <div class="container mt-3">
        <div class="row justify-content-center mb-4">
            <div class="col-md-7">
                <div class="input-group shadow-sm">
                    <input type="text" id="storeSearch" class="form-control border-0 ps-3 py-2" placeholder="Search Amazon Alpha items..." onkeyup="searchProducts()" style="border-radius: 4px 0 0 4px;">
                    <span class="input-group-text bg-warning border-0 px-3" style="border-radius: 0 4px 4px 0; cursor: pointer;">🔍</span>
                </div>
            </div>
        </div>

        <div class="row" id="productsRow">
            <% products.forEach(product => { %>
                <div class="col-lg-4 col-md-6 mb-4 product-card-wrapper">
                    <div class="card h-100 shadow-sm p-2">
                        <img src="<%= product.imageUrl %>" class="card-img-top" alt="<%= product.name %>">
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="fw-bold text-dark product-name mb-1"><%= product.name %></h6>
                            
                            <div class="text-warning small mb-2">
                                <% let stars = Math.floor(product.rating || 4.5); %>
                                <% for(let i=0; i<5; i++) { %>
                                    <%= i < stars ? '★' : '☆' %>
                                <% } %>
                                <span class="text-primary small ms-1">(<%= product.rating || 4.5 %>)</span>
                            </div>

                            <p class="card-text text-muted small mb-3 flex-grow-1"><%= product.description %></p>
                            
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="fs-4 fw-medium text-dark"><span class="fs-6 align-text-top">$</span><%= Math.floor(product.price) %><span class="fs-6 align-text-top">99</span></span>
                                <span class="text-success small fw-bold">FREE Delivery</span>
                            </div>

                            <form action="/add-to-cart/<%= product._id %>" method="POST">
                                <div class="d-flex align-items-center gap-2 mb-3">
                                    <label class="small text-secondary m-0">Qty:</label>
                                    <select name="quantity" class="form-select form-select-sm border-secondary-subtle" style="width: 70px; border-radius: 6px;">
                                        <option value="1">1</option>
                                        <option value="2">2</option>
                                        <option value="3">3</option>
                                        <option value="4">4</option>
                                    </select>
                                </div>
                                <button type="submit" class="btn btn-amazon w-100 py-2 shadow-sm">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div class="fixed-bottom bottom-nav py-2 text-center shadow-lg">
        <div class="container d-flex justify-content-around">
            <a href="/" class="nav-link-custom active"><span class="nav-icon">🏠</span>Home</a>
            <a href="/cart" class="nav-link-custom"><span class="nav-icon">🛒</span>Cart</a>
            <a href="#" onclick="alert('🎁 Flash Sale Promo Deal Code: CLASHALPHA2026 active for 15% discount deductions!')" class="nav-link-custom"><span class="nav-icon">🎁</span>Offers</a>
            <a href="/account" class="nav-link-custom"><span class="nav-icon">👤</span>Account</a>
        </div>
    </div>

    <script>
        function searchProducts() {
            let input = document.getElementById('storeSearch').value.toLowerCase();
            let cards = document.getElementsByClassName('product-card-wrapper');
            for (let i = 0; i < cards.length; i++) {
                let productName = cards[i].querySelector('.product-name').innerText.toLowerCase();
                cards[i].style.display = productName.includes(input) ? "" : "none";
            }
        }
    </script>
</body>
</html>