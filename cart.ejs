<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Amazon Alpha - Checkout Hub</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; background-color: #eaeded; padding-bottom: 90px; }
        .amazon-nav { background-color: #131921; }
        .box-card { border: 1px solid #ddd; border-radius: 8px; background: #fff; }
        .btn-amazon-buy { background: #ffd814; border: 1px solid #fcd200; color: #0f1111; border-radius: 8px; font-weight: 500; }
        .btn-amazon-buy:hover { background: #f7ca00; }
        .bottom-nav { background: #ffffff; border-top: 1px solid #ddd; z-index: 1030; }
        .nav-link-custom { text-decoration: none; color: #565959; font-size: 12px; font-weight: 500; }
        .nav-link-custom.active, .nav-link-custom:hover { color: #e77600; }
        .nav-icon { font-size: 20px; display: block; margin-bottom: 2px; }
        .profile-header { background: linear-gradient(135deg, #131921, #232f3e); color: white; border-radius: 8px 8px 0 0; }
    </style>
</head>
<body>

    <nav class="navbar navbar-dark amazon-nav px-3 py-2 sticky-top shadow-sm">
        <div class="container d-flex justify-content-between align-items-center">
            <a class="navbar-brand fw-bold fs-4 m-0 text-white" href="/">
                amazon<span class="text-warning fs-5">.alpha</span>
            </a>
            <a class="btn btn-outline-light btn-sm rounded-pill px-3" href="/">← Storefront</a>
        </div>
    </nav>

    <div class="container mt-4">
        <% if (viewMode === 'account') { %>
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="box-card shadow-sm mb-4">
                        <div class="p-4 profile-header text-center position-relative">
                            <div class="rounded-circle bg-warning text-dark d-inline-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm mb-2" style="width: 80px; height: 80px;">
                                <%= user.username.charAt(0).toUpperCase() %>
                            </div>
                            <h4 class="fw-bold m-0">Hello, <%= user.username %>!</h4>
                            <p class="text-white-50 small m-0">Amazon Alpha Prime Member Status Verified</p>
                        </div>
                        <div class="p-4 bg-white rounded-bottom">
                            <h5 class="fw-bold mb-3 text-dark">Your Account Settings Dashboard</h5>
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <div class="p-3 border rounded-3 bg-light">
                                        <h6>📦 Your Orders</h6>
                                        <small class="text-muted">Track, return, or buy items again.</small>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 border rounded-3 bg-light">
                                        <h6>🔒 Login & Security</h6>
                                        <small class="text-muted">Edit login credentials and details.</small>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 border rounded-3 bg-light">
                                        <h6>💳 Your Payments</h6>
                                        <small class="text-muted">Manage active wallets and card systems.</small>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 border rounded-3 bg-light">
                                        <h6>🏠 Your Addresses</h6>
                                        <small class="text-muted">Configure active home shipping layouts.</small>
                                    </div>
                                </div>
                            </div>
                            <div class="text-center mt-4">
                                <a href="/logout" class="btn btn-outline-danger btn-sm rounded-pill px-4">Secure Sign Out of Profile</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        <% } else { %>
            <h3 class="fw-bold text-dark mb-4">Shopping Cart Overview</h3>
            <div class="row">
                <div class="col-lg-7 col-md-6 mb-4">
                    <div class="p-4 box-card shadow-sm">
                        <h5 class="fw-bold mb-3 text-secondary">1. Review Items</h5>
                        <% if (cartItems.length === 0) { %>
                            <div class="text-center my-4">
                                <p class="text-muted fs-5 m-0">Your Shopping Cart is completely empty.</p>
                                <a href="/" class="btn btn-warning btn-sm mt-3 rounded-pill px-4">Browse Marketplace Items</a>
                            </div>
                        <% } else { %>
                            <ul class="list-group list-group-flush mb-3">
                                <% let totalSum = 0; %>
                                <% cartItems.forEach(item => { %>
                                    <% let costValue = item.productId.price * item.quantity; %>
                                    <% totalSum += costValue; %>
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                        <div>
                                            <h6 class="fw-bold m-0 text-dark"><%= item.productId.name %></h6>
                                            <small class="text-muted">Selected Quantity Allocation: <%= item.quantity %></small>
                                        </div>
                                        <span class="badge bg-dark rounded-pill px-3 py-2">$<%= costValue %>.99</span>
                                    </li>
                                <% }) %>
                            </ul>
                            <div class="d-flex justify-content-between align-items-center bg-light p-3 rounded-3 mt-2">
                                <h5 class="fw-bold m-0">Subtotal Amount:</h5>
                                <h4 class="fw-bold text-dark m-0">$<%= totalSum %>.99</h4>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="col-lg-5 col-md-6 mb-4">
                    <div class="p-4 box-card shadow-sm">
                        <h5 class="fw-bold mb-3 text-secondary">2. Delivery Logistics & Review Notes</h5>
                        <form action="/checkout" method="POST">
                            <div class="mb-2"><input type="text" class="form-control" placeholder="Full Recipient Name" required></div>
                            <div class="mb-2"><input type="text" class="form-control" placeholder="Street Delivery Address" required></div>
                            <div class="row g-2 mb-3">
                                <div class="col-6"><input type="text" class="form-control" placeholder="City Location" required></div>
                                <div class="col-6"><input type="text" class="form-control" placeholder="Zip Code" required></div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted text-uppercase">Add a Review feedback / Delivery Instruction Notes:</label>
                                <textarea class="form-control" rows="2" placeholder="Write any product suggestions or packaging comments here..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-amazon-buy w-100 py-2 fw-bold shadow-sm" <%= cartItems.length === 0 ? 'disabled' : '' %>>
                                Proceed to Order Checkout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <div class="fixed-bottom bottom-nav py-2 text-center shadow-lg">
        <div class="container d-flex justify-content-around">
            <a href="/" class="nav-link-custom <%= viewMode === 'shop' ? 'active' : '' %>"><span class="nav-icon">🏠</span>Home</a>
            <a href="/cart" class="nav-link-custom <%= viewMode === 'cart' ? 'active' : '' %>"><span class="nav-icon">🛒</span>Cart</a>
            <a href="#" onclick="alert('🎁 Flash Sale Promo Deal Code: CLASHALPHA2026 active for 15% discount deductions!')" class="nav-link-custom"><span class="nav-icon">🎁</span>Offers</a>
            <a href="/account" class="nav-link-custom <%= viewMode === 'account' ? 'active' : '' %>"><span class="nav-icon">👤</span>Account</a>
        </div>
    </div>

</body>
</html>